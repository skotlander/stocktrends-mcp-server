{
  "name": "@stocktrends-publications/stocktrends-mcp-server",
  "version": "1.0.1",
  "mcpName": "com.stocktrends/market-intelligence",
  "description": "Stock Trends MCP adapter with local stdio and fail-closed Streamable HTTP public discovery support.",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "stocktrends-mcp-server": "dist/server.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skotlander/stocktrends-mcp-server.git"
  },
  "homepage": "https://github.com/skotlander/stocktrends-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/skotlander/stocktrends-mcp-server/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:runtime-deps": "node scripts/check-runtime-dependency-contract.mjs",
    "check:package-metadata": "node scripts/check-package-metadata.mjs",
    "check:mcp-registry-metadata": "node scripts/check-mcp-registry-metadata.mjs",
    "check:release-workflow": "node scripts/check-release-workflow.mjs"
  },
  "keywords": [
    "mcp",
    "stocktrends"
  ],
  "author": "Stocktrends Publications",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
