{
  "mcpName": "com.stocktrends/market-intelligence",
  "name": "com.stocktrends/market-intelligence",
  "version": "1.1.0",
  "description": "Market context infrastructure for trading systems and AI agents - 16M+ classified observations since 1980, 4 context layers, ST-IM probabilistic distributions",
  "packages": [
    {
      "name": "@stocktrends-publications/stocktrends-mcp-server",
      "registry": "npm",
      "transport": "stdio",
      "version": "1.1.0"
    }
  ],
  "remotes": [
    {
      "url": "https://mcp.stocktrends.com/mcp",
      "transport": "streamable-http",
      "description": "Public Remote MCP - 3 free tools credential-free, 16 premium via OAuth subscription"
    }
  ],
  "auth": {
    "type": "oauth2",
    "optional": true,
    "issuer": "https://auth.stocktrends.com/",
    "audience": "https://mcp.stocktrends.com",
    "jwks_uri": "https://auth.stocktrends.com/.well-known/jwks.json",
    "authorization_url": "https://auth.stocktrends.com/oauth/authorize",
    "token_url": "https://auth.stocktrends.com/oauth/token",
    "scopes": [
      "openid",
      "profile",
      "read:indicators",
      "read:market",
      "write:portfolio"
    ],
    "description": "OAuth 2.0 with PKCE. Free mode works without auth (3 tools). Premium requires OAuth that maps to Stock Trends subscription."
  },
  "capabilities": {
    "tools": 19,
    "resources": 10,
    "prompts": 0,
    "free_tools": [
      "stocktrends_estimate_workflow_cost",
      "stocktrends_lookup_instruments",
      "stocktrends_resolve_instrument"
    ],
    "paid_tools": [
      "stocktrends_get_stim_latest",
      "stocktrends_get_stim_history",
      "stocktrends_get_indicators_latest",
      "stocktrends_get_indicators_history",
      "stocktrends_get_selections_latest",
      "stocktrends_get_market_regime_latest",
      "stocktrends_get_market_regime_history",
      "stocktrends_get_breadth_sector_latest",
      "stocktrends_get_leadership_summary_latest",
      "stocktrends_get_screener_top",
      "stocktrends_get_market_epoch_latest",
      "stocktrends_get_market_epoch_history",
      "stocktrends_evaluate_symbol",
      "stocktrends_construct_portfolio",
      "stocktrends_evaluate_portfolio",
      "stocktrends_compare_portfolios"
    ]
  },
  "security": {
    "default_mode": "credential-free",
    "refuses_api_key_in_free_mode": true,
    "exposure_vs_execution": "separate_gates",
    "execution_requires": [
      "STOCKTRENDS_ENABLE_PAID_TOOLS=true",
      "STOCKTRENDS_API_KEY from OAuth mapping",
      "STOCKTRENDS_ENABLE_PAID_EXECUTION=true",
      "pricing_preflight",
      "nonzero_caps"
    ]
  },
  "meta_ai_connector": {
    "phase_1": {
      "auth": "none",
      "tools": 3,
      "status": "ready_now"
    },
    "phase_2": {
      "auth": "oauth2",
      "tools": 19,
      "billing": "Stripe subscription outside Meta, OAuth maps sub to API key",
      "eta": "3 weeks"
    }
  }
}